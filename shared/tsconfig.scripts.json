// The test and tooling scripts are run by tsx, which strips types without
// checking them — so on their own they would drift out of sync with src and
// nobody would find out. This config type-checks them alongside the library.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "scripts"]
}
