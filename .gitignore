# Dependencies
node_modules/

# Build output (each workspace builds into its own dist/)
dist/
dist-ssr/
build/

# TypeScript incremental build info (tsc -b), wherever it lands
*.tsbuildinfo

# Env files — client/.env carries VITE_SERVER_URL, never commit real values.
# .env.example files ARE meant to be committed and are re-allowed below.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db

# Test / tooling caches
coverage/
.vite/
.turbo/
*.local

# Misc local tools
.qodo/

# Bug reports saved from Discord (they hold whole match states)
bug/
