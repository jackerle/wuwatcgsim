# Both of these are optional. Left unset, the client connects to whatever
# host served the page, on port 3001 — right for local dev and for the
# simplest cloud deployment (one host, two exposed ports). See
# client/src/socket.ts for the exact logic and when you need an override.

# Full override — set this when the server is NOT "this host, another
# port": a split deployment where client and server live on different
# domains, for instance.
# VITE_SERVER_URL=https://api.example.com

# Port-only override — set this when the host guess is right but the
# server doesn't listen on 3001.
# VITE_SERVER_PORT=3001
